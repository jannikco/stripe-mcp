{
  "openapi": "3.1.0",
  "info": {
    "title": "Stripe selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.stripe.com"
    }
  ],
  "paths": {
    "/v1/customers": {
      "get": {
        "operationId": "stripe_list_customers",
        "summary": "stripe list customers",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "Stripe-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2026-10-28.endive",
              "default": "2026-10-28.endive"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "stripe_create_customer",
        "summary": "stripe create customer",
        "parameters": [
          {
            "name": "Stripe-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2026-10-28.endive",
              "default": "2026-10-28.endive"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/customers/{customer}": {
      "get": {
        "operationId": "stripe_get_customer",
        "summary": "stripe get customer",
        "parameters": [
          {
            "name": "customer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Stripe-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2026-10-28.endive",
              "default": "2026-10-28.endive"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
